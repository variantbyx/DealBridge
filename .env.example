# =================================================================
# DEALBRIDGE - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server Port (Default: 5001)
PORT=5001

# Application Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/dealbridge
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dealbridge?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/dealbridge

# JSON Web Token (JWT) Secret Key (Use a cryptographically secure 64-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration Window
JWT_EXPIRES_IN=7d

# Frontend Client Origin URL (for CORS allowed origins)
# In development: http://localhost:5173
# In production: https://<your-deployed-frontend>.vercel.app
CLIENT_URL=http://localhost:5173
